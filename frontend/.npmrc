# @hookform/resolvers объявляет ОПЦИОНАЛЬНЫЙ peer `ajv-formats@^2` для ajv-адаптера,
# который мы не используем (используем zod-resolver). Контрактный тест и mcp-sdk
# от shadcn требуют `ajv-formats@^3`. Строгий peer-resolution npm не может
# удовлетворить обе мажорные версии, поэтому даём явное ослабление peer-check.
legacy-peer-deps=true